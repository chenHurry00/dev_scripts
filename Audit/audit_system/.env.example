# 服务器审计系统 - 环境变量配置示例
# 复制此文件为 .env 并修改配置

# Flask 配置
FLASK_ENV=production
SECRET_KEY=your-flask-secret-key-change-me

# Admin 账户配置
AUDIT_ADMIN_USER=admin
AUDIT_ADMIN_PASSWORD=Admin@2026!Change

# API 配置
API_SECRET_KEY=your-api-secret-key-change-me

# 数据库配置（可选，默认使用 data/audit.db）
# AUDIT_DB=/path/to/audit.db

# 日志配置（可选）
# LOG_DIR=/path/to/logs
